{
  "buildCommand": "npm run build:ssg",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(korzina|kabinet|vkhod|registraciya|admin)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
